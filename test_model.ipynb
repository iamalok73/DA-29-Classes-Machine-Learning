   "source": [
    "import pickle\n",
    "\n",
    "def load_model(filename):\n",
    "    with open(filename, 'rb') as file:\n",
    "        model = pickle.load(file)\n",
    "    return model"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 20,
   "id": "8692f13a-856d-45fa-9246-f9396bb6d350",
   "metadata": {},
   "outputs": [],
   "source": [
    "loaded_model = load_model('knn_model.pkl')"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 21,
   "id": "5898b5f6-aec8-4460-994f-008ada5261db",
